  <!-- JAVASCRIPT ARCHITECTURE -->
  <script>
    /* 1. MOCK DATABASE INITIALIZATION */
    const productsDB = [
      { id: 1, name: "Wireless Noise-Canceling Earbuds", category: "Mobile Accessories", price: 1850, image: "https://images.unsplash.com/photo-1590658268037-6bf12165a8df?auto=format&fit=crop&w=400&q=80", desc: "Crystal clear audio quality, deep bass, and 24-hour battery backup with fast charging support." },
      { id: 2, name: "Smart Fitness Watch Series 7", category: "Electronics", price: 2400, image: "https://images.unsplash.com/photo-1523275335684-37898b6baf30?auto=format&fit=crop&w=400&q=80", desc: "Heart rate monitor, step tracking, OLED display screen, and water resistance up to 50 meters." },
      { id: 3, name: "Men's Premium Casual Cotton Shirt", category: "Fashion", price: 1250, image: "https://images.unsplash.com/photo-1602810318383-e386cc2a3ccf?auto=format&fit=crop&w=400&q=80", desc: "100% pure breathable cotton material, perfect tailored fit for Bangladeshi climate." },
      { id: 4, name: "Electric Coffee & Spice Grinder", category: "Home & Kitchen", price: 1600, image: "https://images.unsplash.com/photo-1588854337236-6889d631faa8?auto=format&fit=crop&w=400&q=80", desc: "Stainless steel blade design for high speed efficient grinding of coffee beans and kitchen spices." },
      { id: 5, name: "Hydrating Face Serum - Vitamin C", category: "Beauty", price: 950, image: "https://images.unsplash.com/photo-1620916566398-39f1143ab7be?auto=format&fit=crop&w=400&q=80", desc: "Brightens dark spots, promotes collagen, suitable for all sensitive skin types." },
      { id: 6, name: "Remote Control Stunt Car", category: "Baby & Toys", price: 1450, image: "https://images.unsplash.com/photo-1594787318286-3d835c1d207f?auto=format&fit=crop&w=400&q=80", desc: "360-degree rotation stunt car with rechargeable battery and 2.4GHz remote controller." }
    ];

    let ordersDB = JSON.parse(localStorage.getItem('shopnest_orders')) || [
      {
        id: "ORD-1001",
        customer: { name: "Ariful Islam", phone: "01819000000", address: "House 12, Road 4", district: "Dhaka", upazila: "Dhanmondi", note: "Call before coming" },
        items: [{ id: 1, name: "Wireless Noise-Canceling Earbuds", price: 1850, qty: 1 }],
        total: 1910,
        paymentStatus: "Unpaid (COD)",
        status: "Pending",
        date: "2026-03-30"
      }
    ];

    let cart = [];
    let activeProduct = null;

    /* 2. CORE SYSTEM INITIALIZATION */
    document.addEventListener("DOMContentLoaded", () => {
      renderProducts(productsDB);
      updateCartCount();
      renderAdminDashboard();
      initScrollAnimations();
    });

    /* 3. NAVIGATION VIEW SWITCHER */
    function switchView(viewName) {
      document.querySelectorAll('.page-view').forEach(view => view.classList.remove('active'));
      const targetView = document.getElementById(viewName + 'View');
      if (targetView) targetView.classList.add('active');
      window.scrollTo({ top: 0, behavior: 'smooth' });
    }

    /* 4. PRODUCT RENDERING & FILTERING */
    function renderProducts(items) {
      const container = document.getElementById('productsContainer');
      container.innerHTML = items.map(product => `
        <div class="product-card">
          <div class="product-img">
            <img src="${product.image}" alt="${product.name}">
          </div>
          <div class="product-info">
            <span class="product-category">${product.category}</span>
            <h3 class="product-title">${product.name}</h3>
            <div class="product-price">৳ ${product.price}</div>
            <div class="product-actions">
              <button class="btn btn-outline" onclick="openProductDetail(${product.id})">Details</button>
              <button class="btn btn-primary" onclick="quickOrder(${product.id})">Order Now</button>
            </div>
          </div>
        </div>
      `).join('');
    }

    function filterCategory(cat) {
      const filtered = productsDB.filter(p => p.category === cat);
      renderProducts(filtered);
      document.getElementById('products').scrollIntoView({ behavior: 'smooth' });
    }

    function handleSearch() {
      const query = document.getElementById('searchInput').value.toLowerCase();
      const filtered = productsDB.filter(p => p.name.toLowerCase().includes(query) || p.category.toLowerCase().includes(query));
      renderProducts(filtered);
    }

    /* 5. PRODUCT DETAILS MODAL VIEW */
    function openProductDetail(id) {
      activeProduct = productsDB.find(p => p.id === id);
      document.getElementById('detailImg').src = activeProduct.image;
      document.getElementById('detailTitle').innerText = activeProduct.name;
      document.getElementById('detailCategory').innerText = activeProduct.category;
      document.getElementById('detailPrice').innerText = '৳ ' + activeProduct.price;
      document.getElementById('detailDesc').innerText = activeProduct.desc;
      switchView('productDetail');
    }

    /* 6. CART MANAGEMENT */
    function addToCart(product) {
      const existing = cart.find(item => item.id === product.id);
      if (existing) {
        existing.qty++;
      } else {
        cart.push({ ...product, qty: 1 });
      }
      updateCartCount();
      renderCartView();
    }

    function addToCartCurrent() {
      if (activeProduct) {
        addToCart(activeProduct);
        alert('Added to cart!');
      }
    }

    function quickOrder(id) {
      const prod = productsDB.find(p => p.id === id);
      cart = [{ ...prod, qty: 1 }];
      updateCartCount();
      renderCartView();
      switchView('cart');
    }

    function buyNowCurrent() {
      if (activeProduct) {
        cart = [{ ...activeProduct, qty: 1 }];
        updateCartCount();
        renderCartView();
        switchView('cart');
      }
    }

    function updateCartCount() {
      const count = cart.reduce((acc, curr) => acc + curr.qty, 0);
      document.getElementById('cartCount').innerText = count;
    }

    function renderCartView() {
      const list = document.getElementById('cartItemsList');
      if (cart.length === 0) {
        list.innerHTML = `<p style="color: var(--text-muted);">Your cart is empty.</p>`;
        calculateDeliveryCharge();
        return;
      }

      list.innerHTML = cart.map((item, idx) => `
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 12px;">
          <div>
            <h4 style="font-size: 0.95rem;">${item.name}</h4>
            <div style="font-size: 0.85rem; color: var(--text-muted);">৳ ${item.price} x ${item.qty}</div>
          </div>
          <div style="display: flex; align-items: center; gap: 8px;">
            <button onclick="changeQty(${idx}, -1)" class="btn btn-outline" style="padding: 2px 8px;">-</button>
            <span>${item.qty}</span>
            <button onclick="changeQty(${idx}, 1)" class="btn btn-outline" style="padding: 2px 8px;">+</button>
          </div>
        </div>
      `).join('');

      calculateDeliveryCharge();
    }

    function changeQty(index, delta) {
      cart[index].qty += delta;
      if (cart[index].qty <= 0) cart.splice(index, 1);
      updateCartCount();
      renderCartView();
    }

    function calculateDeliveryCharge() {
      const district = document.getElementById('custDistrict').value;
      const subtotal = cart.reduce((acc, curr) => acc + (curr.price * curr.qty), 0);
      let fee = 120; // Default outside Dhaka

      if (district === "Dhaka") {
        fee = 60;
      }

      document.getElementById('subTotal').innerText = `৳ ${subtotal}`;
      document.getElementById('deliveryCharge').innerText = `৳ ${fee}`;
      document.getElementById('grandTotal').innerText = `৳ ${subtotal + (cart.length > 0 ? fee : 0)}`;
    }

    /* 7. CHECKOUT & ORDER SUBMISSION */
    function handlePlaceOrder(e) {
      e.preventDefault();
      if (cart.length === 0) {
        alert("Your cart is empty! Add products first.");
        return;
      }

      const subtotal = cart.reduce((acc, curr) => acc + (curr.price * curr.qty), 0);
      const district = document.getElementById('custDistrict').value;
      const deliveryFee = district === "Dhaka" ? 60 : 120;
      const grandTotal = subtotal + deliveryFee;

      const newOrder = {
        id: "ORD-" + Math.floor(1000 + Math.random() * 9000),
        customer: {
          name: document.getElementById('custName').value,
          phone: document.getElementById('custPhone').value,
          district: district,
          upazila: document.getElementById('custUpazila').value,
          address: document.getElementById('custAddress').value,
          note: document.getElementById('custNote').value
        },
        items: [...cart],
        total: grandTotal,
        paymentStatus: "Unpaid (COD)",
        status: "Pending",
        date: new Date().toISOString().split('T')[0]
      };

      ordersDB.unshift(newOrder);
      localStorage.setItem('shopnest_orders', JSON.stringify(ordersDB));

      // Reset
      cart = [];
      updateCartCount();
      document.getElementById('checkoutForm').reset();

      alert(`Order Placed Successfully! Your Order ID is ${newOrder.id}`);
      renderAdminDashboard();
      
      // Auto redirect to order tracking view
      document.getElementById('trackInput').value = newOrder.id;
      switchView('tracking');
      trackOrder();
    }

    /* 8. ORDER TRACKING LOGIC */
    function trackOrder() {
      const queryId = document.getElementById('trackInput').value.trim();
      const order = ordersDB.find(o => o.id.toLowerCase() === queryId.toLowerCase());

      const resultBox = document.getElementById('trackingResult');
      if (!order) {
        alert('Order ID not found. Please double check.');
        resultBox.style.display = "none";
        return;
      }

      document.getElementById('trackOrderId').innerText = order.id;
      document.getElementById('trackName').innerText = order.customer.name;
      resultBox.style.display = "block";

      const steps = ["Pending", "Confirmed", "Packed", "Shipped", "Delivered"];
      const currentIdx = steps.indexOf(order.status);

      steps.forEach((st, idx) => {
        const el = document.getElementById(`step-${st}`);
        if (el) {
          if (idx <= currentIdx && order.status !== "Cancelled") {
            el.classList.add('completed');
          } else {
            el.classList.remove('completed');
          }
        }
      });
    }

    /* 9. ADMIN DASHBOARD ACTIONS */
    function renderAdminDashboard() {
      const tableBody = document.getElementById('adminOrdersTable');
      
      // Compute Stats
      const totalOrders = ordersDB.length;
      const pendingOrders = ordersDB.filter(o => o.status === "Pending").length;
      const revenue = ordersDB.filter(o => o.status === "Delivered").reduce((acc, curr) => acc + curr.total, 0);

      document.getElementById('statTotalOrders').innerText = totalOrders;
      document.getElementById('statPendingOrders').innerText = pendingOrders;
      document.getElementById('statRevenue').innerText = `৳ ${revenue}`;

      tableBody.innerHTML = ordersDB.map(order => `
        <tr>
          <td><strong>${order.id}</strong></td>
          <td>${order.customer.name}</td>
          <td>${order.customer.phone}</td>
          <td>${order.customer.address}, ${order.customer.upazila}, ${order.customer.district}</td>
          <td>${order.items.map(i => `${i.name} (x${i.qty})`).join(', ')}</td>
          <td>৳ ${order.total}</td>
          <td><span class="status-badge ${order.paymentStatus.includes('Paid') ? 'status-delivered' : 'status-pending'}">${order.paymentStatus}</span></td>
          <td><span class="status-badge status-${order.status.toLowerCase()}">${order.status}</span></td>
          <td>
            <div class="action-btn-group">
              ${order.status === 'Pending' ? `<button class="action-btn act-confirm" onclick="updateOrderStatus('${order.id}', 'Confirmed')">Confirm</button>` : ''}
              ${order.status === 'Confirmed' ? `<button class="action-btn act-pack" onclick="updateOrderStatus('${order.id}', 'Packed')">Pack</button>` : ''}
              ${order.status === 'Packed' ? `<button class="action-btn act-ship" onclick="updateOrderStatus('${order.id}', 'Shipped')">Ship</button>` : ''}
              ${order.status === 'Shipped' ? `<button class="action-btn act-deliver" onclick="updateOrderStatus('${order.id}', 'Delivered')">Deliver</button>` : ''}
              ${order.status !== 'Delivered' && order.status !== 'Cancelled' ? `<button class="action-btn act-cancel" onclick="updateOrderStatus('${order.id}', 'Cancelled')">Cancel</button>` : ''}
            </div>
          </td>
        </tr>
      `).join('');
    }

    function updateOrderStatus(orderId, newStatus) {
      const order = ordersDB.find(o => o.id === orderId);
      if (order) {
        order.status = newStatus;
        if (newStatus === "Delivered") {
          order.paymentStatus = "Paid (COD)";
        }
        localStorage.setItem('shopnest_orders', JSON.stringify(ordersDB));
        renderAdminDashboard();
      }
    }

    /* 10. UI UTILITIES */
    function toggleFaq(el) {
      const item = el.parentElement;
      item.classList.toggle('active');
    }

    function initScrollAnimations() {
      const observer = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
          if (entry.isIntersecting) {
            entry.target.classList.add('visible');
          }
        });
      }, { threshold: 0.1 });

      document.querySelectorAll('.fade-in').forEach(el => observer.observe(el));
    }
  </script>
</body>
</html>
